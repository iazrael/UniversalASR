{
  "name": "universal-asr-service",
  "version": "1.0.0",
  "description": "Universal Real-time ASR Gateway Service with multi-vendor support",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
