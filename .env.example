# 服务端口与监听地址
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# 对下游客户端开放的 API Token / Key 白名单（多个用英文逗号分隔；设置为 * 表示免鉴权测试模式）
AUTH_TOKENS=default-client-token,test-token-123

# 默认 ASR 厂商 (aliyun / dashscope)
DEFAULT_PROVIDER=aliyun

# 阿里云 DashScope / Paraformer 配置
# 请前往阿里云百炼控制台获取 API-Key: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here
DASHSCOPE_MODEL=paraformer-realtime-v2
DASHSCOPE_WS_URL=wss://dashscope.aliyuncs.com/api-v1/services/audio/asr/transcription

# 会话空闲超时时间（毫秒，默认 60 秒）
SESSION_IDLE_TIMEOUT_MS=60000
# 单次会话最大时长（毫秒，默认 30 分钟）
SESSION_MAX_DURATION_MS=1800000
