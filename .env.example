# 服务端口与监听地址
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# 对下游客户端开放的 API Token / Key 白名单（多个用英文逗号分隔；设置为 * 表示免鉴权测试模式）
AUTH_TOKENS=default-client-token,test-token-123

# 默认 ASR 厂商 (aliyun / dashscope)
DEFAULT_PROVIDER=aliyun

# 阿里云 DashScope 配置
# 前往获取: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here
# 可选：百炼业务空间 ID（若配置将优先使用北京专属 MaaS 域名加速）
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_MODEL=paraformer-realtime-v2
DASHSCOPE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference

# 本地 / 私有化 OMLX ASR 配置 (支持 Qwen3-ASR, Whisper, Voxtral 等)
OMLX_BASE_URL=https://omlx.com
OMLX_API_KEY=omlx-05yfs07frti3p4lz
OMLX_MODEL=Qwen3-ASR-1.7B-8bit

# 会话空闲超时时间（毫秒，默认 60 秒）
SESSION_IDLE_TIMEOUT_MS=60000
# 单次会话最大时长（毫秒，默认 30 分钟）
SESSION_MAX_DURATION_MS=1800000

# ── 成本防护配置 ──────────────────────────────────────────

# 单次识别最大时长（毫秒，默认 30 秒，超时自动 stop，防止单次计费过高）
UTTERANCE_MAX_DURATION_MS=30000

# IP 限流：每 IP 每日最大识别次数（学校/家庭共享出口 IP，建议放宽）
RATE_LIMIT_DAILY_PER_IP=200
# IP 限流：每 IP 最大并发 WebSocket 连接数
RATE_LIMIT_MAX_CONCURRENT_PER_IP=3

# 预算熔断：每日最大识别次数（超限后全局拒绝新请求，次日自动重置）
BUDGET_DAILY_MAX_COUNT=5000
# 预算熔断：每日最大累计识别时长（毫秒，默认 5 小时 = 18000000）
BUDGET_DAILY_MAX_DURATION_MS=18000000
# 预算熔断：每月最大识别次数
BUDGET_MONTHLY_MAX_COUNT=100000
# 预算熔断：用量告警阈值（0~1，达到此比例时输出警告日志）
BUDGET_WARN_THRESHOLD=0.8
# 预算熔断：用量持久化文件路径（相对项目根目录）
BUDGET_PERSIST_PATH=data/usage.json

# Ticket：有效期（毫秒，默认 60 秒，每次识别前前端先领票）
TICKET_TTL_MS=60000
# Ticket：是否绑定签发 IP（true/false，开启后换 IP 不可用，学校多出口可能有问题）
TICKET_BIND_IP=false
